# Email Sender Configuration
# ==========================
# Rename this file to .env and fill in your credentials.
#
# Quick start:
#   1. Set EMAIL_ADDRESS and EMAIL_PASSWORD
#   2. Set EMAIL_PROVIDER to your provider key (see list below)
#   3. Run: python send_email.py --to yourself@example.com -s "Test" -b "Hello"
#
# Supported providers and their keys:
#   163     — 163邮箱 (DEFAULT)
#   qq      — QQ邮箱
#   qq_ex   — QQ企业邮箱
#   126     — 126邮箱
#   sina    — 新浪邮箱
#   foxmail — Foxmail邮箱
#   yeah    — Yeah.net邮箱
#   139     — 139邮箱（移动）
#   189     — 189邮箱（电信）
#   aliyun  — 阿里企业邮箱
#   sohu    — 搜狐邮箱
#   gmail   — Gmail (需要App Password)
#   outlook — Outlook / Hotmail
#   yahoo   — Yahoo邮箱
#   zoho    — Zoho邮箱
#   aol     — AOL邮箱
#   yandex  — Yandex邮箱

# ── Required ────────────────────────────────────────────────────────────────

# Your email address
EMAIL_ADDRESS=your_email@163.com

# SMTP authorization code (授权码), NOT your login password.
# For 163: Login to mail.163.com → Settings → POP3/SMTP/IMAP → Enable SMTP
# For QQ:   Settings → Account → POP3/SMTP → Generate code
# For others: See the provider's SMTP documentation.
EMAIL_PASSWORD=your_authorization_code_here

# ── Optional ────────────────────────────────────────────────────────────────

# Email provider preset (keys listed above). Default: 163
EMAIL_PROVIDER=163

# SMTP settings (only needed if not using a preset above, or to override):
# SMTP_SERVER=smtp.163.com
# SMTP_PORT=465

# IMAP settings (only needed if not using a preset above, or to override):
# IMAP_SERVER=imap.163.com
# IMAP_PORT=993

# ── SMTP Server Reference ───────────────────────────────────────────────────
# Provider        | SMTP Server              | Port | Auth Type
# ----------------+--------------------------+------+--------------------
# 163 (DEFAULT)   | smtp.163.com             | 465  | SMTP授权码
# QQ              | smtp.qq.com              | 465  | SMTP授权码
# QQ企业          | smtp.exmail.qq.com       | 465  | SMTP授权码
# 126             | smtp.126.com             | 465  | SMTP授权码
# Gmail           | smtp.gmail.com           | 587  | App Password
# Outlook         | smtp.office365.com       | 587  | 应用密码
# Yahoo           | smtp.mail.yahoo.com      | 465  | App Password
# 新浪            | smtp.sina.com.cn         | 465  | SMTP授权码
# 阿里企业        | smtp.qiye.aliyun.com     | 465  | SMTP密码
# Foxmail         | smtp.foxmail.com         | 465  | SMTP授权码
# 搜狐            | smtp.sohu.com            | 465  | SMTP授权码
# Yeah.net        | smtp.yeah.net            | 465  | SMTP授权码
# 139             | smtp.139.com             | 465  | SMTP密码
# 189             | smtp.189.cn              | 465  | SMTP密码
# Zoho            | smtp.zoho.com            | 587  | App Password
# AOL             | smtp.aol.com             | 587  | App Password
# Yandex          | smtp.yandex.com          | 465  | App Password
