# Email Sender Configuration
# ==========================
# Rename this file to .env and fill in your credentials.

# Your email address (e.g., example@163.com)
EMAIL_ADDRESS=your_email@163.com

# SMTP authorization code (授权码), NOT your login password.
# How to get one:
#   1. Log in to mail.163.com
#   2. Go to Settings (设置) > POP3/SMTP/IMAP
#   3. Enable SMTP service and generate an authorization code
EMAIL_PASSWORD=your_authorization_code_here

# SMTP server settings (163.com defaults)
# For other providers, change these accordingly.
SMTP_SERVER=smtp.163.com
SMTP_PORT=465
