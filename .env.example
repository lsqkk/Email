# Email Sender Multi-Account Configuration
# ========================================
# Rename this file to .env and fill in your credentials.
#
# Format: Define named accounts with [account:key] sections.
# Set DEFAULT_ACCOUNT to control which account is used by default.
#
# Run: python send_email.py --to yourself@example.com -s "Test" -b "Hello"
#      python send_email.py --account qq --to friend@qq.com -s "Hi" -b "Hey"
#      python send_email.py --list-accounts
#
# Supported EMAIL_PROVIDER keys:
#   163     — 163邮箱 (DEFAULT)
#   qq      — QQ邮箱
#   qq_ex   — QQ企业邮箱
#   126     — 126邮箱
#   sina    — 新浪邮箱
#   foxmail — Foxmail邮箱
#   yeah    — Yeah.net邮箱
#   139     — 139邮箱（移动）
#   189     — 189邮箱（电信）
#   aliyun  — 阿里企业邮箱
#   sohu    — 搜狐邮箱
#   gmail   — Gmail (需要App Password)
#   outlook — Outlook / Hotmail
#   yahoo   — Yahoo邮箱
#   zoho    — Zoho邮箱
#   aol     — AOL邮箱
#   yandex  — Yandex邮箱

# ── Default account ─────────────────────────────────────────────────────────
# Must match one of the [account:xxx] names below.
DEFAULT_ACCOUNT=163

# ── Account definitions ─────────────────────────────────────────────────────
# Each account is a [account:name] section with:
#   EMAIL_ADDRESS  — Your email for this account
#   EMAIL_PASSWORD — SMTP authorization code (授权码), NOT login password
#   EMAIL_PROVIDER — One of the provider keys listed above

[account:163]
EMAIL_ADDRESS=your_email@163.com
EMAIL_PASSWORD=your_163_auth_code
EMAIL_PROVIDER=163

[account:qq]
EMAIL_ADDRESS=your_qq@qq.com
EMAIL_PASSWORD=your_qq_auth_code
EMAIL_PROVIDER=qq

# ── Optional: More accounts ─────────────────────────────────────────────────

#[account:gmail]
#EMAIL_ADDRESS=your@gmail.com
#EMAIL_PASSWORD=your_app_password
#EMAIL_PROVIDER=gmail

#[account:outlook]
#EMAIL_ADDRESS=your@outlook.com
#EMAIL_PASSWORD=your_app_password
#EMAIL_PROVIDER=outlook

# ── SMTP Server Reference ───────────────────────────────────────────────────
# Provider        | SMTP Server              | Port | Auth Type
# ----------------+--------------------------+------+--------------------
# 163 (DEFAULT)   | smtp.163.com             | 465  | SMTP授权码
# QQ              | smtp.qq.com              | 465  | SMTP授权码
# QQ企业          | smtp.exmail.qq.com       | 465  | SMTP授权码
# 126             | smtp.126.com             | 465  | SMTP授权码
# Gmail           | smtp.gmail.com           | 587  | App Password
# Outlook         | smtp.office365.com       | 587  | 应用密码
# Yahoo           | smtp.mail.yahoo.com      | 465  | App Password
# 新浪            | smtp.sina.com.cn         | 465  | SMTP授权码
# 阿里企业        | smtp.qiye.aliyun.com     | 465  | SMTP密码
# Foxmail         | smtp.foxmail.com         | 465  | SMTP授权码
# 搜狐            | smtp.sohu.com            | 465  | SMTP授权码
# Yeah.net        | smtp.yeah.net            | 465  | SMTP授权码
# 139             | smtp.139.com             | 465  | SMTP密码
# 189             | smtp.189.cn              | 465  | SMTP密码
# Zoho            | smtp.zoho.com            | 587  | App Password
# AOL             | smtp.aol.com             | 587  | App Password
# Yandex          | smtp.yandex.com          | 465  | App Password
